# Copy this file to .env and fill in real values before running in production.
# In local dev, the app falls back to safe defaults if these are unset.

PORT=3000

# Used to sign JWT auth tokens. MUST be changed to a long random string
# before deploying anywhere real — the fallback in server/auth.js is only
# for local development.
JWT_SECRET=dev-secret-change-me

NODE_ENV=development
